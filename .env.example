# Public client config (exposed to browser via /api/runtime-config)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secrets (Netlify functions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
RESEND_API_KEY=your_resend_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# App/email settings
EMAIL_SENDER=noreply@youragency.com
APP_BASE_URL=https://app.youragency.com

# ── Optional integrations. Each is switched on only when its variables are
# set; runtime-config reports them as flags, so a half-configured deploy falls
# back to the manual path instead of showing a button that errors.

# Google Workspace — create a new hire's Google account from Colony (create
# only; Colony never deletes or edits users) and copy policy pages / signed
# agreements into Google Drive. A service account with domain-wide delegation
# for the admin.directory.user, admin.directory.group.member and drive scopes.
# Netlify caps EVERY environment variable at 4KB and a downloaded key file is
# larger — store only {"client_email": ..., "private_key": ...} here, or the
# deploy fails at the function-upload step.
GOOGLE_SA_JSON={"client_email":"colony@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# A Workspace super-admin the service account acts as.
GOOGLE_ADMIN_IMPERSONATE=admin@youragency.com

# Papersign — employment/consulting agreements drafted from a template, sent
# for e-signature, and the signed PDF filed back automatically.
PAPERSIGN_API_TOKEN=your_papersign_api_token
# Shared secret on the webhook URL (…/api/papersign-webhook?key=…). Papersign
# folder webhooks carry no signature, so this key is the only thing that stops
# anyone else posting a fake "completed" event. Make it long and random.
PAPERSIGN_WEBHOOK_KEY=generate_a_long_random_string
# Who signs for the agency on every agreement, and who hears once it is signed
# (finance, to set up payroll or the vendor; the rest are copied). All
# optional — unset, this deployment's own people are used.
PAPERSIGN_SIGNER_NAME=Your Name
PAPERSIGN_SIGNER_EMAIL=you@youragency.com
PAPERSIGN_FINANCE_EMAIL=finance@youragency.com
PAPERSIGN_FINANCE_NAME=Finance
PAPERSIGN_NOTIFY_CC=you@youragency.com,ops@youragency.com

# Local dev only (NOT used by the app or Netlify) — Supabase Management API,
# lets the CLI run arbitrary SQL without the dashboard. Generate a Personal
# Access Token at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token
SUPABASE_PROJECT_REF=your-project-ref

# Optional: the all-staff Google Group every new account joins (default
# all@youragency.com). Needs the admin.directory.group.member scope above.
WORKSPACE_ALL_GROUP=
